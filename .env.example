# Database
DATABASE_URL=sqlite:///./data/qso_manager.db

# QRZ.com credentials (optional; credentials do NOT unlock writes)
QRZ_API_KEY=
QRZ_USERNAME=
QRZ_DRY_RUN=true
QRZ_WRITE_ENABLED=false

# WRL local UDP bridge (loopback only)
WRL_UDP_HOST=127.0.0.1
WRL_UDP_PORT=2237
WRL_UDP_ENABLED=false

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Environment
ENVIRONMENT=development
